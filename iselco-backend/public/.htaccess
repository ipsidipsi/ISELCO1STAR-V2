<IfModule mod_rewrite.c>
    # I-ON ang makina
    RewriteEngine On
    RewriteBase /

    # [FIX] Payagan ang Authorization Header na makarating sa Laravel
    # Kailangan ito para sa Sanctum token authentication sa Apache
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes (Example: /api/ -> /api)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller (ETO YUNG MAGIC)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>